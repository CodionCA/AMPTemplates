    {
        "DisplayName": "Game Mode",
        "Category": "Call of Duty Modern Warfare 3:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Sets the game mode. Configure the relevant config file accordingly - 'Plutonium/storage/iw5/dedicated.cfg' for Multiplayer, 'Plutonium/storage/iw5/dedicated_zm.cfg' for Zombies",
        "Keywords": "game,mode,gamemode",
        "FieldName": "GameMode",
        "InputType": "enum",
        "ParamFieldName": "GameMode",
        "DefaultValue": "iw5mp \"{{$FullBaseDir}}iw5\" -dedicated +set key {{ServerKey}} +set fs_game \"\" +exec dedicated.cfg",
        "EnumValues": {
            "iw5mp \"{{$FullBaseDir}}iw5\" -dedicated +set key {{ServerKey}} +set fs_game \"\" +exec dedicated.cfg": "Multiplayer (default)",
            "iw5zm \"{{$FullBaseDir}}iw5\" -dedicated +set key {{ServerKey}} +set fs_game \"\" +exec dedicated_zm.cfg": "Zombies"
        }
    },
    {
        "DisplayName": "Server Key",
        "Category": "Call of Duty Modern Warfare 3:stadia_controller",
        "Subcategory": "Server:dns:1",
        "Description": "Sets the [server key](https://platform.plutonium.pw/serverkeys) required to run the server. This also sets the server name. A Plutonium account must be at least one week old to create a key, and game ownership must be [verified](https://forum.plutonium.pw/topic/32250/an-update-on-game-ownership-verification)",
        "Keywords": "server,key,serverkey",
        "FieldName": "ServerKey",
        "InputType": "password",
        "ParamFieldName": "ServerKey",
        "DefaultValue": "",
        "Required": true,
        "EnumValues": {}
    },
